# เว้นว่างทั้งหมดเพื่อใช้ข้อมูลจำลอง (ดู docs/api-contract.md)

# ต่อ backend: เบราว์เซอร์เรียก /api ของเว็บนี้ แล้ว Nuxt ส่งต่อให้
NUXT_PUBLIC_API_BASE=
# ที่อยู่ backend ที่เซิร์ฟเวอร์ Nuxt เรียก เช่น http://localhost:4000
NUXT_API_SERVER_URL=
# ตั้งเป็น true เฉพาะเมื่อมี reverse proxy ของระบบ (เช่น nginx) อยู่หน้า Nuxt
NUXT_TRUST_FORWARDED_FOR=
