# คัดลอกเป็น .env แล้วเติมค่า (ไฟล์ .env ไม่ถูก commit)

# ฐานข้อมูลใน compose.yaml ตั้งรหัสผ่านเป็นตัวอักษรอังกฤษและตัวเลข แล้วใส่ค่าเดียวกันใน DATABASE_URL
DB_PASSWORD=
DB_PORT=3310
DATABASE_URL=mysql://app:<DB_PASSWORD>@127.0.0.1:3310/internship_log

# รหัสผ่านของบัญชีทดสอบที่ pnpm seed สร้าง อย่างน้อย 8 ตัวอักษร ใช้ในเครื่องพัฒนาเท่านั้น
SEED_PASSWORD=

# ฐานข้อมูลของ pnpm test (บริการ db-test ใน compose.yaml) การทดสอบลบผู้ใช้ทั้งหมดในฐานข้อมูลนี้
TEST_DATABASE_URL=mysql://root@127.0.0.1:33998/ils_test

PORT=4000
# ที่อยู่ของหน้าเว็บ คำขอแก้ข้อมูลจากที่อื่นถูกปฏิเสธ หลายค่าคั่นด้วย ,
WEB_ORIGIN=http://localhost:3000
# ตั้ง false เฉพาะตอนพัฒนาผ่าน http บนเครื่องจริงให้ลบบรรทัดนี้
COOKIE_SECURE=false
